<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Voice for agents: push-to-talk dictation (ElevenLabs, the user's own
         key). The hardened runtime blocks the microphone without it; macOS
         still asks the user once (NSMicrophoneUsageDescription). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
