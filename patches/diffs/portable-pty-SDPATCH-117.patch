+    // SDTEST-1745
+    // ShellDeck patch: SDPATCH-117 — prove the Unix command preserves a missing
+    // explicit cwd instead of substituting HOME before process creation.
+    #[cfg(unix)]
+    #[test]
+    fn explicit_missing_unix_cwd_is_forwarded_instead_of_falling_back_home() {
+        use std::time::{SystemTime, UNIX_EPOCH};
+
+        let missing = std::env::temp_dir().join(format!(
+            "portable-pty-missing-unix-cwd-{}-{}",
+            std::process::id(),
+            SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        assert!(!missing.exists());
+
+        let mut cmd = CommandBuilder::new("/bin/sh");
+        cmd.env("HOME", std::env::temp_dir());
+        cmd.cwd(&missing);
+
+        let command = cmd.as_command().expect("Unix command");
+        assert_eq!(command.get_current_dir(), Some(missing.as_path()));
+    }
+
+    // SDTEST-1744
+    // ShellDeck patch: SDPATCH-117 — unit-check the Windows cwd authority
+    // regression beside the dependency code that forwards it to CreateProcessW.
+    #[cfg(windows)]
+    #[test]
+    fn explicit_missing_cwd_is_forwarded_instead_of_falling_back_home() {
+        use std::os::windows::ffi::OsStringExt;
+        use std::time::{SystemTime, UNIX_EPOCH};
+
+        let missing = std::env::temp_dir().join(format!(
+            "portable-pty-missing-cwd-{}-{}",
+            std::process::id(),
+            SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        assert!(!missing.exists());
+
+        let mut cmd = CommandBuilder::new("dummy");
+        cmd.env("USERPROFILE", std::env::temp_dir());
+        cmd.cwd(&missing);
+
+        let mut encoded = cmd.current_directory().expect("explicit cwd");
+        assert_eq!(encoded.pop(), Some(0));
+        assert_eq!(OsString::from_wide(&encoded), missing.into_os_string());
+    }
